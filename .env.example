# Node.js 24+. Copy to .env.local; enter actual secrets privately.
# Set the real HTTPS domain before publishing canonical URLs and sitemap.
STUDIO_URL=
# Defaults to .data in the project. Persist this directory on your host.
STUDIO_DATA_DIR=
# Keep true with HTTPS. Set false ONLY for local HTTP testing.
STUDIO_COOKIE_SECURE=true

# Resend: verified sender and API key. Optional; requests work without email.
STUDIO_MAIL_FROM=
STUDIO_MAIL_KEY=

# Alternative direct SMTP for hosts supporting SMTP egress.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# OpenAI image edits. Optional; unavailable status is shown without a key.
STUDIO_AI_KEY=
STUDIO_AI_MODEL=gpt-image-1

# Optional CRM: HTTPS JSON webhook accepting Bearer authentication.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Optional GA4 measurement ID. Loaded only with analytics consent.
STUDIO_GA_ID=
